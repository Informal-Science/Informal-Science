---
import { withBase } from '../utils/paths';
---

<section class="subscription-panel" id="subscribe" aria-labelledby="subscription-title">
  <div class="container subscription-panel__grid">
    <div class="subscription-panel__copy">
      <p class="eyebrow">Subscribe / 订阅</p>
      <h2 id="subscription-title">
        <span>订阅各期</span>
        <span>《非正式科学》</span>
      </h2>
      <p>扫描二维码关注我们的 QQ 空间，获取新一期发布与后续动态。其他订阅方式将在这里陆续补充。</p>
    </div>

    <figure class="subscription-panel__channel">
      <div class="subscription-panel__qr">
        <img
          src={withBase('/images/subscribe/qq-space-qr.jpg')}
          alt="《非正式科学》QQ 空间二维码"
          width="500"
          height="500"
          loading="lazy"
        />
      </div>
      <figcaption>
        <span>01 / QQ SPACE</span>
        <strong>QQ 空间</strong>
        <p>使用 QQ 扫描二维码关注</p>
      </figcaption>
    </figure>

    <div class="subscription-panel__reserved" aria-label="未来订阅方式预留区域">
      <span>02 / MORE SOON</span>
      <p>更多订阅方式<br />后续加入</p>
    </div>
  </div>
</section>

<style>
  .subscription-panel {
    position: relative;
    padding: clamp(84px, 12vw, 170px) 0;
    color: white;
    background: var(--theme);
    overflow: hidden;
  }

  .subscription-panel::before {
    position: absolute;
    inset: 22px;
    border: 1px solid rgba(255, 255, 255, 0.36);
    content: '';
    pointer-events: none;
  }

  .subscription-panel__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.42fr) minmax(190px, 0.28fr);
    gap: clamp(34px, 7vw, 100px);
    align-items: end;
  }

  .subscription-panel .eyebrow {
    color: rgba(255, 255, 255, 0.66);
  }

  .subscription-panel__copy {
    container-type: inline-size;
  }

  .subscription-panel h2 {
    display: grid;
    width: max-content;
    max-width: 760px;
    justify-items: center;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.25rem, 13.5cqw, 6.8rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .subscription-panel h2 span {
    white-space: nowrap;
  }

  .subscription-panel__copy > p:last-child {
    max-width: 620px;
    margin: 28px 0 0;
    color: rgba(255, 255, 255, 0.75);
  }

  .subscription-panel__channel {
    display: grid;
    gap: 18px;
    margin: 0;
  }

  .subscription-panel__qr {
    padding: 12px;
    background: white;
  }

  .subscription-panel__qr img {
    width: 100%;
    height: auto;
  }

  .subscription-panel__channel figcaption,
  .subscription-panel__reserved {
    display: grid;
  }

  .subscription-panel__channel span,
  .subscription-panel__reserved span {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .subscription-panel__channel strong {
    margin-top: 4px;
    font-size: 1.35rem;
    font-weight: 500;
  }

  .subscription-panel__channel p {
    margin: 2px 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.76rem;
  }

  .subscription-panel__reserved {
    min-height: 210px;
    align-content: space-between;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.36);
  }

  .subscription-panel__reserved p {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .subscription-panel__grid {
      grid-template-columns: 1fr minmax(220px, 0.5fr);
    }

    .subscription-panel__copy {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .subscription-panel__grid {
      grid-template-columns: 1fr;
    }

    .subscription-panel__copy {
      grid-column: auto;
    }

    .subscription-panel__channel {
      width: min(100%, 320px);
    }
  }
</style>
