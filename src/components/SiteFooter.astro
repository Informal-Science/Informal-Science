---
import { withBase } from '../utils/paths';

const footerLinks = [
  { href: '/', label: '首页' },
  { href: '/questions-answers', label: '问题-答案' },
  { href: '/2026', label: '2026 年刊' },
  { href: '/disciplines', label: '七大板块' },
  { href: '/history', label: '往期精彩' },
  { href: '/standards', label: '视觉设计规范' },
  { href: '/about', label: '关于我们' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href={withBase('/')} aria-label="非正式科学首页">
        <img src={withBase('/images/brand/logo-mark.svg')} alt="" width="160" height="160" />
      </a>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      {footerLinks.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>

    <div class="footer-meta">
      <p>福州第一中学基础科学社团联盟</p>
      <p>内容与图片版权归相应作者所有</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(64px, 9vw, 120px) 0 34px;
    color: rgba(255, 255, 255, 0.82);
    background: #101216;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.75fr 1fr;
    gap: 48px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .footer-brand img {
    width: clamp(120px, 11vw, 160px);
    height: auto;
  }

  .footer-nav {
    display: grid;
    grid-template-rows: repeat(4, min-content);
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    gap: 9px clamp(26px, 4vw, 58px);
    align-content: start;
  }

  .footer-nav a {
    width: fit-content;
    border-bottom: 1px solid transparent;
    font-size: 0.9rem;
  }

  .footer-nav a:hover {
    border-bottom-color: currentColor;
  }

  .footer-meta {
    align-self: end;
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.72rem;
    text-align: right;
  }

  .footer-meta p {
    margin: 4px 0;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-meta {
      grid-column: 1 / -1;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      text-align: left;
    }
  }

  @media (max-width: 460px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      grid-column: auto;
    }

    .footer-nav {
      column-gap: 20px;
    }
  }
</style>
