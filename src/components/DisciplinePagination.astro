---
import { withBase } from '../utils/paths';

interface Target {
  href: string;
  name: string;
  color: string;
  ink: string;
}

interface Props {
  previous: Target;
  next: Target;
}

const { previous, next } = Astro.props;
---

<nav class="discipline-pagination" aria-label="板块切换">
  <a
    class="discipline-pagination__item discipline-pagination__item--previous"
    href={withBase(previous.href)}
    style={`--pagination-color: ${previous.color}; --pagination-ink: ${previous.ink}`}
  >
    <span>上一个板块 / PREVIOUS</span>
    <strong>{previous.name}</strong>
    <em aria-hidden="true">← 查看</em>
  </a>
  <a
    class="discipline-pagination__item discipline-pagination__item--next"
    href={withBase(next.href)}
    style={`--pagination-color: ${next.color}; --pagination-ink: ${next.ink}`}
  >
    <span>下一个板块 / NEXT</span>
    <strong>{next.name}</strong>
    <em aria-hidden="true">查看 →</em>
  </a>
</nav>

<style>
  .discipline-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .discipline-pagination__item {
    display: grid;
    min-width: 0;
    min-height: clamp(260px, 28vw, 430px);
    grid-template-rows: auto 1fr auto;
    gap: 28px;
    padding: clamp(34px, 5vw, 74px);
    color: var(--pagination-ink);
    background: var(--pagination-color);
  }

  .discipline-pagination__item--next {
    text-align: right;
  }

  .discipline-pagination span,
  .discipline-pagination em {
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .discipline-pagination strong {
    align-self: center;
    font-size: clamp(3rem, 7vw, 7.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .discipline-pagination__item--previous strong {
    justify-self: start;
  }

  .discipline-pagination__item--next strong,
  .discipline-pagination__item--next em {
    justify-self: end;
  }

  @media (max-width: 760px) {
    .discipline-pagination {
      grid-template-columns: 1fr;
    }

    .discipline-pagination__item {
      min-height: 235px;
    }
  }
</style>
