---
import type { Article, Discipline } from '../data';
import { disciplineUiColor } from '../utils/colors';

interface Props {
  entries: readonly Article[];
  disciplines: readonly Discipline[];
  searchable?: boolean;
  showFilter?: boolean;
}

const { entries, disciplines, searchable = false, showFilter = false } = Astro.props;
const disciplineMap = new Map(disciplines.map((discipline) => [discipline.slug, discipline]));
---

<section class="article-directory" data-article-directory>
  {(searchable || showFilter) && (
    <div class="directory-tools">
      {searchable && (
        <label class="search-field">
          <span>搜索文章</span>
          <input type="search" placeholder="题名、作者或摘要" data-directory-search />
        </label>
      )}
      {showFilter && (
        <label class="filter-field">
          <span>学科</span>
          <select data-directory-filter>
            <option value="all">全部学科</option>
            {disciplines.map((discipline) => <option value={discipline.slug}>{discipline.name}</option>)}
          </select>
        </label>
      )}
      <p class="directory-count" role="status" aria-live="polite" aria-atomic="true"><strong data-directory-count>{entries.length}</strong> 篇目录导读</p>
    </div>
  )}

  <div class="article-list">
    {entries.map((article) => {
      const discipline = disciplineMap.get(article.disciplineSlug);
      return (
        <article
          class="article-row"
          data-article-row
          data-discipline={article.disciplineSlug}
          data-search={`${article.title} ${article.author} ${article.summary}`.toLowerCase()}
          style={`--article-color: ${discipline ? disciplineUiColor(discipline.colorKey) : 'var(--theme)'}`}
        >
          <div class="article-row__page">
            <span>{String(article.page).padStart(2, '0')}</span>
            <em>PAGE</em>
          </div>
          <div class="article-row__content">
            <p class="article-row__discipline">iS {discipline?.name} {discipline?.en}</p>
            <h2>{article.title}</h2>
            <p>{article.summary}</p>
          </div>
          <div class="article-row__author">
            <span>撰文</span>
            <strong>{article.author}</strong>
            <em>目录导读</em>
          </div>
        </article>
      );
    })}
  </div>

  <p class="empty-state" data-empty-state hidden>没有找到符合条件的文章。</p>
</section>

{(searchable || showFilter) && (
  <script>
    document.querySelectorAll('[data-article-directory]').forEach((directory) => {
      const search = directory.querySelector('[data-directory-search]');
      const filter = directory.querySelector('[data-directory-filter]');
      const rows = [...directory.querySelectorAll('[data-article-row]')];
      const count = directory.querySelector('[data-directory-count]');
      const empty = directory.querySelector('[data-empty-state]');

      const update = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const discipline = filter instanceof HTMLSelectElement ? filter.value : 'all';
        let visible = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const matchesSearch = !query || row.dataset.search?.includes(query);
          const matchesFilter = discipline === 'all' || row.dataset.discipline === discipline;
          row.hidden = !(matchesSearch && matchesFilter);
          if (!row.hidden) visible += 1;
        });

        if (count) count.textContent = String(visible);
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      };

      search?.addEventListener('input', update);
      filter?.addEventListener('change', update);
    });
  </script>
)}

<style>
  .directory-tools {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(160px, 0.35fr) auto;
    gap: 14px;
    align-items: end;
    padding: 26px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .search-field,
  .filter-field {
    display: grid;
    gap: 7px;
  }

  .search-field span,
  .filter-field span {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .search-field input,
  .filter-field select {
    width: 100%;
    height: 46px;
    padding: 0 15px;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--ink);
    background: var(--surface);
  }

  .directory-count {
    margin: 0 0 11px;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .directory-count strong {
    color: var(--ink);
    font-size: 1rem;
  }

  .article-list {
    border-top: 1px solid var(--line-strong);
  }

  .directory-tools + .article-list {
    border-top: 0;
  }

  .article-row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) minmax(120px, 0.2fr);
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(28px, 4vw, 50px) 0;
    border-bottom: 1px solid var(--line);
  }

  .article-row::before {
    position: absolute;
    top: 0;
    bottom: -1px;
    left: -24px;
    width: 4px;
    background: var(--article-color);
    content: '';
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .article-row:hover::before {
    opacity: 1;
  }

  .article-row[hidden] {
    display: none;
  }

  .article-row__page {
    display: grid;
    align-content: start;
  }

  .article-row__page span {
    color: var(--article-color);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1;
  }

  .article-row__page em {
    margin-top: 5px;
    color: var(--ink-soft);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.12em;
  }

  .article-row__discipline {
    margin: 0 0 9px !important;
    color: var(--article-color) !important;
    font-size: 0.68rem !important;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .article-row__content h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 2.3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .article-row__content > p:last-child {
    max-width: 760px;
    margin: 16px 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .article-row__author {
    display: grid;
    align-content: start;
    gap: 3px;
    padding-top: 27px;
    text-align: right;
  }

  .article-row__author span,
  .article-row__author em {
    color: var(--ink-soft);
    font-size: 0.65rem;
    font-style: normal;
  }

  .article-row__author strong {
    font-family: var(--font-editorial);
    font-size: 0.95rem;
  }

  .empty-state {
    margin: 0;
    padding: 80px 0;
    color: var(--ink-soft);
    text-align: center;
  }

  @media (max-width: 720px) {
    .directory-tools {
      grid-template-columns: 1fr;
    }

    .directory-count {
      margin: 4px 0 0;
    }

    .article-row {
      grid-template-columns: 48px 1fr;
      gap: 14px;
    }

    .article-row::before {
      left: -16px;
    }

    .article-row__author {
      grid-column: 2;
      grid-template-columns: auto auto 1fr;
      gap: 8px;
      padding: 0;
      text-align: left;
    }

    .article-row__author em {
      text-align: right;
    }
  }
</style>
