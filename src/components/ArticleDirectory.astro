---
import BookMarker from './BookMarker.astro';
import type { Article, Discipline, HistoricalDiscipline } from '../data';
import { disciplineUiColor } from '../utils/colors';

interface Props {
  entries: readonly Article[];
  disciplines: readonly (Discipline | HistoricalDiscipline)[];
  searchable?: boolean;
  showFilter?: boolean;
  showIssueFilter?: boolean;
  emptyMessage?: string;
}

const {
  entries,
  disciplines,
  searchable = false,
  showFilter = false,
  showIssueFilter = false,
  emptyMessage = '暂无已整理的文章导读。',
} = Astro.props;
const disciplineMap = new Map(disciplines.map((discipline) => [discipline.slug, discipline]));
const availableIssues = [
  ...new Map(
    entries.map((article) => [
      `${article.year}-${article.issueNumber}`,
      { year: article.year, issueNumber: article.issueNumber },
    ]),
  ).values(),
].sort((a, b) => b.year - a.year || b.issueNumber - a.issueNumber);
---

<section class="article-directory" data-article-directory>
  {(searchable || showFilter || showIssueFilter) && (
    <div class:list={['directory-tools', { 'directory-tools--with-issue': showIssueFilter }]}>
      {searchable && (
        <label class="search-field">
          <span>搜索文章</span>
          <input type="search" placeholder="题名、作者、摘要、年份或期数" data-directory-search />
        </label>
      )}
      {showFilter && (
        <label class="filter-field">
          <span>学科</span>
          <select data-directory-discipline>
            <option value="all">全部学科</option>
            {disciplines.map((discipline) => <option value={discipline.slug}>{discipline.name}</option>)}
          </select>
        </label>
      )}
      {showIssueFilter && (
        <label class="filter-field">
          <span>年份（期次）</span>
          <select data-directory-issue>
            <option value="all">全部年刊</option>
            {availableIssues.map((issue) => (
              <option value={`${issue.year}-${issue.issueNumber}`}>
                {issue.year}年 总第{issue.issueNumber}期
              </option>
            ))}
          </select>
        </label>
      )}
      <p class="directory-count" role="status" aria-live="polite" aria-atomic="true"><strong data-directory-count>{entries.length}</strong> 篇目录导读</p>
    </div>
  )}

  <div class="article-list">
    {entries.map((article) => {
      const discipline = disciplineMap.get(article.disciplineSlug);
      return (
        <article
          id={article.slug}
          class:list={['article-row', { 'article-row--without-author': !article.author }]}
          data-article-row
          data-discipline={article.disciplineSlug}
          data-year={article.year}
          data-issue={`${article.year}-${article.issueNumber}`}
          data-search={`${article.title} ${article.author} ${article.summary} ${article.year} 总第 ${article.issueNumber} 期`.toLowerCase()}
          style={`--article-color: ${discipline ? disciplineUiColor(discipline.colorKey) : 'var(--theme)'}`}
        >
          <div class="article-row__page">
            <BookMarker
              kind="toc-number"
              value={String(article.page)}
              size="clamp(44px, 5vw, 56px)"
              foreground="white"
              background="var(--article-color)"
            />
            <em>PAGE</em>
          </div>
          <div class="article-row__content">
            <div class="article-row__labels">
              <span>{article.year}年刊 · 总第{article.issueNumber}期</span>
              <span>{discipline?.name} / {discipline?.en}</span>
            </div>
            <h2>{article.title}</h2>
            {article.summary && <p>{article.summary}</p>}
          </div>
          {article.author && (
            <div class="article-row__author">
              <span>撰文</span>
              <strong>{article.author}</strong>
              <em>目录导读</em>
            </div>
          )}
        </article>
      );
    })}
  </div>

  <p class="empty-state" data-empty-state hidden={entries.length > 0}>{emptyMessage}</p>
</section>

{(searchable || showFilter || showIssueFilter) && (
  <script>
    document.querySelectorAll('[data-article-directory]').forEach((directory) => {
      const search = directory.querySelector('[data-directory-search]');
      const disciplineFilter = directory.querySelector('[data-directory-discipline]');
      const issueFilter = directory.querySelector('[data-directory-issue]');
      const rows = [...directory.querySelectorAll('[data-article-row]')];
      const count = directory.querySelector('[data-directory-count]');
      const empty = directory.querySelector('[data-empty-state]');

      const update = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const discipline = disciplineFilter instanceof HTMLSelectElement ? disciplineFilter.value : 'all';
        const issue = issueFilter instanceof HTMLSelectElement ? issueFilter.value : 'all';
        let visible = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const matchesSearch = !query || row.dataset.search?.includes(query);
          const matchesFilter = discipline === 'all' || row.dataset.discipline === discipline;
          const matchesIssue = issue === 'all' || row.dataset.issue === issue;
          row.hidden = !(matchesSearch && matchesFilter && matchesIssue);
          if (!row.hidden) visible += 1;
        });

        if (count) count.textContent = String(visible);
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      };

      search?.addEventListener('input', update);
      disciplineFilter?.addEventListener('change', update);
      issueFilter?.addEventListener('change', update);
    });
  </script>
)}

<style>
  .directory-tools {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(160px, 0.35fr) auto;
    gap: 14px;
    align-items: end;
    padding: 26px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .directory-tools--with-issue {
    grid-template-columns: minmax(220px, 1fr) repeat(2, minmax(140px, 0.3fr)) auto;
  }

  .search-field,
  .filter-field {
    display: grid;
    gap: 7px;
  }

  .search-field span,
  .filter-field span {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .search-field input,
  .filter-field select {
    width: 100%;
    height: 46px;
    padding: 0 15px;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--ink);
    background: var(--surface);
  }

  .directory-count {
    margin: 0 0 11px;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .directory-count strong {
    color: var(--ink);
    font-size: 1rem;
  }

  .article-list {
    border-top: 1px solid var(--line-strong);
  }

  .directory-tools + .article-list {
    border-top: 0;
  }

  .article-row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) minmax(120px, 0.2fr);
    gap: clamp(20px, 4vw, 56px);
    padding: clamp(28px, 4vw, 50px) 0;
    border-bottom: 1px solid var(--line);
  }

  .article-row--without-author {
    grid-template-columns: 72px minmax(0, 1fr);
  }

  .article-row::before {
    position: absolute;
    top: 0;
    bottom: -1px;
    left: -24px;
    width: 4px;
    background: var(--article-color);
    content: '';
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .article-row:hover::before {
    opacity: 1;
  }

  .article-row[hidden] {
    display: none;
  }

  .article-row__page {
    display: grid;
    align-content: start;
  }

  .article-row__page em {
    margin-top: 5px;
    color: var(--ink-soft);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.12em;
  }

  .article-row__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .article-row__labels span {
    padding: 3px 7px;
    border: 1px solid var(--article-color);
    color: var(--article-color);
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.05em;
  }

  .article-row__content h2 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 2.3rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .article-row__content > p:last-child {
    max-width: 760px;
    margin: 16px 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .article-row__author {
    display: grid;
    align-content: start;
    gap: 3px;
    padding-top: 27px;
    text-align: right;
  }

  .article-row__author span,
  .article-row__author em {
    color: var(--ink-soft);
    font-size: 0.65rem;
    font-style: normal;
  }

  .article-row__author strong {
    font-family: var(--font-editorial);
    font-size: 0.95rem;
  }

  .empty-state {
    margin: 0;
    padding: 80px 0;
    color: var(--ink-soft);
    text-align: center;
  }

  @media (max-width: 720px) {
    .directory-tools {
      grid-template-columns: 1fr;
    }

    .directory-count {
      margin: 4px 0 0;
    }

    .article-row {
      grid-template-columns: 48px 1fr;
      gap: 14px;
    }

    .article-row::before {
      left: -16px;
    }

    .article-row__author {
      grid-column: 2;
      grid-template-columns: auto auto 1fr;
      gap: 8px;
      padding: 0;
      text-align: left;
    }

    .article-row__author em {
      text-align: right;
    }
  }
</style>
