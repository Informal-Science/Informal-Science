---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDirectory from '../../components/ArticleDirectory.astro';
import { articles, contentDisciplines, issues } from '../../data';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return issues.map((issue) => ({
    params: { year: String(issue.year) },
    props: { issue },
  }));
}

type Issue = (typeof issues)[number];

interface Props {
  issue: Issue;
}

const { issue } = Astro.props;
const issueIndex = issues.findIndex((item) => item.year === issue.year);
const previousIssue = issueIndex > 0 ? issues[issueIndex - 1] : undefined;
const nextIssue = issueIndex < issues.length - 1 ? issues[issueIndex + 1] : undefined;
const issueArticles = articles.filter((article) => article.year === issue.year);
const catalogNotice =
  issue.year >= 2021 && issue.year <= 2024
    ? '本页文章目录依据已提供的本期扫描目录录入。全文尚未开放。'
    : issue.year === 2025
      ? '本页文章目录采用已提供并确认为 2025 年的目录资料。全文尚未开放。'
      : '2026 年目录依据 Beta-B-2 版本录入，页码暂填 1，待最终排版确定后更新。全文尚未开放。';
---

<BaseLayout
  title={`${issue.year} 年刊 · 总第 ${issue.number} 期`}
  description={`《非正式科学》${issue.year} 年刊，总第 ${issue.number} 期往期回顾。`}
>
  <section class="issue-detail">
    <div class="container issue-detail__grid">
      <div class="issue-detail__cover">
        <img
          src={withBase(issue.coverAsset)}
          alt={`《非正式科学》${issue.year} 年刊封面`}
          width="900"
          height="1273"
        />
      </div>

      <div class="issue-detail__copy">
        <p class="eyebrow">Past Issues / Issue No. {String(issue.number).padStart(2, '0')}</p>
        <h1>{issue.year}</h1>
        <p class="issue-detail__edition">
          <span>《非正式科学》</span>
          <span>{issue.year} 年刊 · 总第 {issue.number} 期</span>
        </p>
        <p class="issue-detail__credit">{issue.editorialCredit.role}：{issue.editorialCredit.name}</p>

        <dl>
          <div><dt>收录状态</dt><dd>封面、版本信息与 {issueArticles.length} 篇文章导读已整理</dd></div>
          <div><dt>在线阅读</dt><dd>目录导读已开放，全文尚未开放</dd></div>
          <div><dt>PDF 下载</dt><dd>尚未开放</dd></div>
        </dl>

        <p class="issue-detail__notice">{catalogNotice}</p>
        <div class="issue-detail__actions">
          <a class="button-link" href={withBase('/history')}>返回往期精彩</a>
          <a class="text-link" href={withBase('/questions-answers')}>检索历年文章</a>
        </div>
      </div>
    </div>
  </section>

  <section class="issue-directory" id="directory">
    <div class="container issue-directory__heading">
      <div>
        <p class="eyebrow">Contents / {issue.year}</p>
        <h2 class="section-title">本期文章</h2>
      </div>
      <p>本页仅展示 {issue.year} 年·总第 {issue.number} 期的文章导读。如需跨年份、跨学科检索，请前往<a href={withBase('/questions-answers')}>“文章检索”</a>。</p>
    </div>
    <div class="container">
      <ArticleDirectory entries={issueArticles} disciplines={contentDisciplines} />
    </div>
  </section>

  <nav class="issue-pagination" aria-label="年度切换">
    <div class="container issue-pagination__inner">
      {previousIssue ? (
        <a href={withBase(`/history/${previousIssue.year}`)}>
          <span>← 上一期</span>
          <strong>{previousIssue.year}</strong>
        </a>
      ) : <span></span>}
      {nextIssue && (
        <a href={withBase(`/history/${nextIssue.year}`)}>
          <span>下一期 →</span>
          <strong>{nextIssue.year}</strong>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>

<style>
  .issue-detail {
    padding: clamp(80px, 12vw, 170px) 0;
  }

  .issue-detail__grid {
    display: grid;
    grid-template-columns: minmax(260px, 0.7fr) 1fr;
    gap: clamp(56px, 11vw, 150px);
    align-items: center;
  }

  .issue-detail__cover {
    max-width: 520px;
    aspect-ratio: 210 / 297;
    background: #ddd;
    box-shadow: var(--shadow-soft);
  }

  .issue-detail__cover img {
    width: 100%;
    height: 100%;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .issue-detail__copy h1 {
    margin: 0;
    font-size: clamp(6rem, 16vw, 15rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.05em;
  }

  .issue-detail__edition {
    display: grid;
    margin: 38px 0 22px !important;
    color: var(--ink) !important;
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 2.75vw, 2.8rem);
    font-weight: 900;
    line-height: 1.4;
    letter-spacing: -0.035em;
  }

  .issue-detail__edition span:last-child {
    white-space: nowrap;
  }

  .issue-detail__credit {
    margin: 0 !important;
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 600;
  }

  .issue-detail__copy > p {
    max-width: 560px;
    color: var(--ink-soft);
  }

  .issue-detail__copy dl {
    max-width: 560px;
    margin: 42px 0 32px;
  }

  .issue-detail__copy dl div {
    display: grid;
    grid-template-columns: 130px 1fr;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }

  .issue-detail__copy dt {
    font-weight: 500;
  }

  .issue-detail__copy dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .issue-detail__notice {
    margin: 0 0 28px;
    font-size: 0.76rem;
  }

  .issue-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 26px;
    align-items: center;
  }

  .issue-directory {
    padding: clamp(76px, 11vw, 150px) 0;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .issue-directory__heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.4fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 54px;
  }

  .issue-directory__heading > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .issue-directory__heading a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .issue-pagination {
    border-top: 1px solid var(--line);
  }

  .issue-pagination__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .issue-pagination a {
    display: flex;
    min-height: 160px;
    flex-direction: column;
    justify-content: center;
    padding: 30px 0;
  }

  .issue-pagination a:last-child {
    align-items: end;
    border-left: 1px solid var(--line);
  }

  .issue-pagination span {
    color: var(--ink-soft);
    font-size: 0.72rem;
  }

  .issue-pagination strong {
    margin-top: 4px;
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  @media (max-width: 760px) {
    .issue-detail__grid {
      grid-template-columns: 1fr;
    }

    .issue-detail__cover {
      width: min(80%, 520px);
    }

    .issue-directory__heading {
      grid-template-columns: 1fr;
    }
  }
</style>
