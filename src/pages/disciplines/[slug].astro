---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDirectory from '../../components/ArticleDirectory.astro';
import DisciplineHero from '../../components/DisciplineHero.astro';
import DisciplinePagination from '../../components/DisciplinePagination.astro';
import { disciplines, contentDisciplines, articles } from '../../data';
import { disciplineUiColor, disciplineUiTextColor } from '../../utils/colors';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return disciplines.map((discipline) => ({
    params: { slug: discipline.routeSlug },
    props: { discipline },
  }));
}

type Discipline = (typeof disciplines)[number];

interface Props {
  discipline: Discipline;
}

const { discipline } = Astro.props;
const disciplineArticles = articles.filter((article) => article.disciplineSlug === discipline.slug);
const currentIndex = disciplines.findIndex((item) => item.slug === discipline.slug);
const otherTarget = { href: '/disciplines/other', name: '其他', color: '#666666', ink: '#ffffff' };
const targetFromDiscipline = (item: (typeof disciplines)[number]) => ({
  href: `/disciplines/${item.routeSlug}`,
  name: item.name,
  color: disciplineUiColor(item.colorKey),
  ink: disciplineUiTextColor(item.colorKey),
});
const previousDiscipline = disciplines[currentIndex - 1];
const nextDiscipline = disciplines[currentIndex + 1];
const previousTarget = previousDiscipline ? targetFromDiscipline(previousDiscipline) : otherTarget;
const nextTarget = nextDiscipline ? targetFromDiscipline(nextDiscipline) : otherTarget;
---

<BaseLayout
  title={discipline.name}
  description={`《非正式科学》2021 至 2026 年刊·${discipline.name}板块历年文章：${discipline.summary}`}
>
  <DisciplineHero
    name={discipline.name}
    summary={discipline.summary}
    sequence={`${String(discipline.order).padStart(2, '0')} / 07`}
    articleCount={disciplineArticles.length}
    secondaryCount={6}
    secondaryLabel="期年刊"
    color={disciplineUiColor(discipline.colorKey)}
    ink={disciplineUiTextColor(discipline.colorKey)}
  />

  <section class="discipline-directory">
    <div class="container discipline-directory__heading">
      <div>
        <p class="eyebrow">Contents / 2021—2026</p>
        <h2 class="section-title">历年文章</h2>
      </div>
      <p>汇总 2021 至 2026 六期中的本学科文章，并标明年份与期数。如需跨学科组合检索，请前往<a href={withBase('/questions-answers')}>“文章检索”</a>。</p>
    </div>
    <div class="container">
      <ArticleDirectory entries={disciplineArticles} disciplines={contentDisciplines} />
    </div>
  </section>

  <DisciplinePagination previous={previousTarget} next={nextTarget} />
</BaseLayout>

<style>
  .discipline-directory {
    padding: clamp(76px, 11vw, 150px) 0;
    background: var(--surface);
  }

  .discipline-directory__heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.35fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 60px;
  }

  .discipline-directory__heading > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .discipline-directory__heading a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 800px) {
    .discipline-directory__heading {
      grid-template-columns: 1fr;
    }
  }
</style>
