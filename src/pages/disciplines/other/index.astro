---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleDirectory from '../../../components/ArticleDirectory.astro';
import DisciplineHero from '../../../components/DisciplineHero.astro';
import DisciplinePagination from '../../../components/DisciplinePagination.astro';
import { articles, contentDisciplines, disciplines, historicalDisciplines } from '../../../data';
import { disciplineUiColor, disciplineUiTextColor, shouldUseDarkText } from '../../../utils/colors';
import { withBase } from '../../../utils/paths';

const formatCmyk = (field: (typeof historicalDisciplines)[number]) => {
  const { c, m, y, k } = field.cmyk;
  return `C ${Math.round(c * 100)} · M ${Math.round(m * 100)} · Y ${Math.round(y * 100)} · K ${Math.round(k * 100)}`;
};
const formatRgb = (field: (typeof historicalDisciplines)[number]) => field.rgb.join(' · ');
const historicalSlugs = new Set<string>(historicalDisciplines.map((field) => field.slug));
const historicalArticles = articles.filter((article) => historicalSlugs.has(article.disciplineSlug));
const firstDiscipline = disciplines[0];
const lastDiscipline = disciplines.at(-1)!;
const previousTarget = {
  href: `/disciplines/${lastDiscipline.routeSlug}`,
  name: lastDiscipline.name,
  color: disciplineUiColor(lastDiscipline.colorKey),
  ink: disciplineUiTextColor(lastDiscipline.colorKey),
};
const nextTarget = {
  href: `/disciplines/${firstDiscipline.routeSlug}`,
  name: firstDiscipline.name,
  color: disciplineUiColor(firstDiscipline.colorKey),
  ink: disciplineUiTextColor(firstDiscipline.colorKey),
};
---

<BaseLayout
  title="其他"
  description="《非正式科学》历史上曾设置、现已退出当前学科编制的脑神经科学与电子板块。"
>
  <DisciplineHero
    name="其他"
    summary="这些板块曾参与构建《非正式科学》的内容体系，不属于当下七大板块。"
    sequence="08 / ARCHIVE"
    articleCount={historicalArticles.length}
    articleLabel="篇历史导读"
    secondaryCount={historicalDisciplines.length}
    secondaryLabel="个历史板块"
    color="#666666"
    ink="#ffffff"
  />

  <section class="historical-fields">
    <div class="container historical-fields__heading">
      <p class="eyebrow">Former Sections / Color Archive</p>
      <h2>退出历史舞台，<br />但仍被记住。</h2>
      <p>以下 CMYK、RGB 与 HEX 均来自统一颜色参数表，分别用于历史板块的印刷与数字界面。</p>
    </div>

    <div class="container historical-fields__grid">
      {historicalDisciplines.map((field, index) => (
        <article
          class:list={['historical-field', { 'historical-field--dark-ink': shouldUseDarkText(field.webHex) }]}
          style={`--field-color: ${field.webHex}`}
        >
          <div class="historical-field__color">
            <span>{String(index + 1).padStart(2, '0')} / HISTORICAL</span>
            <strong>{field.name}</strong>
          </div>
          <div class="historical-field__copy">
            <p class="historical-field__status">历史板块，已退出当下《非正式科学》的舞台。</p>
            <h3>{field.name} <span>/ {field.en}</span></h3>
            <p>{field.summary}</p>
            <dl>
              <div><dt>PRINT</dt><dd>{formatCmyk(field)}</dd></div>
              <div><dt>RGB</dt><dd>{formatRgb(field)}</dd></div>
              <div><dt>HEX</dt><dd>{field.webHex}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="discipline-directory" id="articles">
    <div class="container discipline-directory__heading">
      <div>
        <p class="eyebrow">Contents / Historical Fields</p>
        <h2 class="section-title">历年文章</h2>
      </div>
      <p>汇总脑神经科学与电子两个历史板块的历年文章。它们也会进入各期“往期精彩”和<a href={withBase('/questions-answers')}>“文章检索”</a>检索。</p>
    </div>
    <div class="container">
      <ArticleDirectory
        entries={historicalArticles}
        disciplines={contentDisciplines}
        emptyMessage="历史板块文章尚未录入；后续补充年度目录后会自动显示在这里。"
      />
    </div>
  </section>

  <DisciplinePagination previous={previousTarget} next={nextTarget} />
</BaseLayout>

<style>
  .historical-fields {
    padding: clamp(76px, 11vw, 150px) 0;
    background: var(--surface);
  }

  .historical-fields__heading {
    display: grid;
    grid-template-columns: 0.35fr 1fr minmax(280px, 0.45fr);
    gap: clamp(30px, 6vw, 90px);
    align-items: end;
    margin-bottom: clamp(48px, 8vw, 90px);
  }

  .historical-fields__heading h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 6vw, 6rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.06em;
  }

  .historical-fields__heading > p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }

  .historical-fields__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .historical-field {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .historical-field__color {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(24px, 4vw, 44px);
    color: white;
    background: var(--field-color);
  }

  .historical-field--dark-ink .historical-field__color {
    color: var(--ink);
  }

  .historical-field__color span,
  .historical-field__status {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .historical-field__color strong {
    font-size: clamp(2.8rem, 7vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0.02em;
  }

  .historical-field__copy {
    min-height: 330px;
    padding: clamp(26px, 4vw, 44px);
  }

  .historical-field__status {
    margin: 0 0 12px;
    color: var(--ink-soft);
  }

  .historical-field h3 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .historical-field h3 span {
    font-size: 0.55em;
    letter-spacing: 0.02em;
  }

  .historical-field__copy > p:not(.historical-field__status) {
    max-width: 34rem;
    margin: 24px 0 34px;
    color: var(--ink-soft);
  }

  .historical-field dl {
    margin: 0;
  }

  .historical-field dl div {
    display: grid;
    grid-template-columns: 74px 1fr;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .historical-field dt {
    color: var(--ink-soft);
  }

  .historical-field dd {
    margin: 0;
    font-weight: 500;
  }

  .discipline-directory {
    padding: clamp(76px, 11vw, 150px) 0;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .discipline-directory__heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.35fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 60px;
  }

  .discipline-directory__heading > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .discipline-directory__heading a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 820px) {
    .historical-fields__heading,
    .discipline-directory__heading {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .historical-fields__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
