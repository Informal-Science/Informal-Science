---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import DisciplineGrid from '../../components/DisciplineGrid.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="七大板块"
  description="《非正式科学》2026 年刊的天文、数学、地理、物理、工程、生物与化学七大学科板块。"
>
  <PageIntro
    eyebrow="Seven Fields / Seven Ways of Seeing"
    title="七大板块"
    description="七种观察世界的尺度，也是一套贯穿书刊与网站的内容和颜色系统。点击任一板块，进入该学科的 2026 文章导读。"
    aside="学科颜色继承自书籍的 CMYK 标准；屏幕显示版本经过网页适配，印刷权威值可在颜色标准页查看。"
  />

  <section class="disciplines-list">
    <DisciplineGrid />
  </section>

  <section class="standards-callout">
    <div class="container standards-callout__inner">
      <p class="eyebrow">Visual System</p>
      <h2>颜色不是装饰，<br />而是内容的索引。</h2>
      <a class="button-link" href={withBase('/standards/colors')}>查看颜色标准</a>
    </div>
  </section>
</BaseLayout>

<style>
  .disciplines-list {
    background: var(--surface);
  }

  .standards-callout {
    padding: clamp(90px, 13vw, 180px) 0;
    color: white;
    background: #101216;
  }

  .standards-callout__inner {
    display: grid;
    grid-template-columns: 0.3fr 1fr auto;
    gap: clamp(32px, 7vw, 100px);
    align-items: end;
  }

  .standards-callout h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.4rem, 5.8vw, 6.2rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.06em;
  }

  .standards-callout .button-link:hover {
    color: var(--ink);
    background: white;
  }

  @media (max-width: 820px) {
    .standards-callout__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
