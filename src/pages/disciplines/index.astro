---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import DisciplineGrid from '../../components/DisciplineGrid.astro';
---

<BaseLayout
  title="七大板块"
  description="《非正式科学》2021 至 2026 年刊的天文、数学、地理、物理、工程、生物与化学七大学科板块。"
>
  <PageIntro
    eyebrow="Seven Fields / Seven Ways of Seeing"
    title="七大板块"
    description="七种观察世界的尺度，也是一套贯穿书刊与网站的内容和颜色系统。点击任一现行板块，进入该学科的历年文章导读。"
    aside="七大板块之后另设“其他”入口，收录已离开当下内容体系的历史板块。学科颜色的印刷权威值可在视觉设计规范页查看。"
  />

  <section class="disciplines-list">
    <DisciplineGrid />
  </section>
</BaseLayout>

<style>
  .disciplines-list {
    background: var(--surface);
  }
</style>
