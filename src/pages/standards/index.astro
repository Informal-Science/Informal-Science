---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookMarker from '../../components/BookMarker.astro';
import PageIntro from '../../components/PageIntro.astro';
import { colorStandards } from '../../data';
import { shouldUseDarkText } from '../../utils/colors';
import { withBase } from '../../utils/paths';

const formatCmyk = (color: (typeof colorStandards)[number]) => {
  const { c, m, y, k } = color.cmyk;
  return `C ${Math.round(c * 100)} · M ${Math.round(m * 100)} · Y ${Math.round(y * 100)} · K ${Math.round(k * 100)}`;
};
const formatRgb = (color: (typeof colorStandards)[number]) => color.rgb.join(' · ');
const articleTitlePreview = withBase('/images/hero/hero-2026-1920.webp');
const articleBodyPreview = withBase('/images/hero/hero-2026-1920.webp');
---

<BaseLayout
  title="视觉设计规范"
  description="《非正式科学》2026 颜色系统、字体分工与数字界面视觉设计规范。"
>
  <PageIntro
    eyebrow="Visual Design Standards"
    title="视觉设计规范"
    description="从印刷书刊到数字网站，以统一的颜色系统、字体分工与界面原则延续《非正式科学》的视觉语言。"
    aside="CMYK、RGB 与 HEX 统一以《color-parameter.md》为准；网站直接使用表内 RGB 色，不再自动换算或为界面另行改色。"
    editorial
  />

  <section class="color-overview">
    <div class="container color-overview__grid">
      <div>
        <p class="eyebrow">System Logic</p>
        <h2>一色一学科，<br />一眼找到方向。</h2>
      </div>
      <p>印刷物使用列明的 CMYK，数字界面使用列明的 RGB / HEX。学科色用于建立导航和内容识别；大色块上的文字会根据对比度自动选择深色或白色，但基础色值始终不变。</p>
    </div>
  </section>

  <section class="swatch-section">
    <div class="container swatch-grid">
      {colorStandards.map((color, index) => (
        <article class:list={['swatch', { 'swatch--light': shouldUseDarkText(color.webHex) }]} style={`--swatch: ${color.webHex}`}>
          <div class="swatch__color">
            <span>{String(index).padStart(2, '0')}</span>
            <div class="swatch__mark">
              <BookMarker kind="logo" value="iS" size="3.84rem" decorative />
            </div>
          </div>
          <div class="swatch__copy">
            <p>{color.key.toUpperCase()}</p>
            <h2>{color.name}</h2>
            <dl>
              <div><dt>PRINT</dt><dd>{formatCmyk(color)}</dd></div>
              <div><dt>RGB</dt><dd>{formatRgb(color)}</dd></div>
              <div><dt>HEX</dt><dd>{color.webHex}</dd></div>
            </dl>
            <p class="swatch__usage">{color.usage}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="type-standard">
    <div class="container type-standard__grid">
      <div>
        <p class="eyebrow">Typography / 字体分工</p>
        <h2>三种声音，<br />各司其职。</h2>
      </div>
      <div class="type-samples">
        <article class="type-sample type-sample--sans">
          <span>01 · INFORMATION</span>
          <h3>HarmonyOS Sans SC</h3>
          <p>用于正文、导航、目录、摘要、作者信息、数字和界面组件。轻体承担正文，Medium 与 Bold 建立信息层级。</p>
        </article>
        <article class="type-sample type-sample--serif">
          <span>02 · EDITORIAL</span>
          <h3>非正式科学</h3>
          <p>Noto Serif CJK SC 用于刊名、封面式大标题、重点引语和少量编辑性强调。</p>
        </article>
        <article class="type-sample type-sample--math">
          <span>03 · MATH</span>
          <h3 aria-label="e 的 i theta 次方等于 cos theta 加 i sin theta">e<sup>iθ</sup> = cos θ + i sin θ</h3>
          <p>STIX Two Math 只用于数学公式、变量、运算符、上下标和公式编号，不进入普通正文。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="layout-standard" aria-labelledby="layout-standard-title">
    <div class="container layout-standard__heading">
      <div>
        <p class="eyebrow">Layout / 版式网格</p>
        <h2 id="layout-standard-title">留出呼吸，<br />建立秩序。</h2>
      </div>
      <p>书刊采用 A4 双面版式，以装订侧区分内外页边距；正文在固定版心内使用双栏排列。以下尺寸直接取自 2026 书籍模板，单位均为毫米。</p>
    </div>

    <div class="container layout-standard__demos">
      <figure class="layout-demo">
        <figcaption>
          <span>01 / PAGE MARGIN</span>
          <div>
            <h3>页边距设置</h3>
            <p>上 14mm、下 15mm、内侧 20mm、外侧 17mm；奇偶页的内外侧随装订方向自动镜像。</p>
          </div>
        </figcaption>

        <div
          class="margin-spec"
          role="img"
          aria-label="A4 双面书刊页边距：上 14 毫米，下 15 毫米，内侧 20 毫米，外侧 17 毫米，左右页镜像排列"
        >
          <div class="margin-spec__spread" aria-hidden="true">
            <div class="print-page print-page--verso">
              <span class="print-page__top">14</span>
              <span class="print-page__outer">17</span>
              <span class="print-page__inner">20</span>
              <div class="print-page__content"><b>EVEN</b><i></i></div>
              <span class="print-page__bottom">15</span>
            </div>
            <div class="print-page print-page--recto">
              <span class="print-page__top">14</span>
              <span class="print-page__inner">20</span>
              <span class="print-page__outer">17</span>
              <div class="print-page__content"><b>ODD</b><i></i></div>
              <span class="print-page__bottom">15</span>
            </div>
          </div>
          <div class="margin-spec__legend" aria-hidden="true">
            <span>OUTER · 17 MM</span>
            <span>SPINE</span>
            <span>INNER · 20 MM</span>
          </div>
        </div>
      </figure>

      <figure class="layout-demo">
        <figcaption>
          <span>02 / COLUMN GAP</span>
          <div>
            <h3>栏间距设置</h3>
            <p>正文版心宽 173mm，分为两个 83mm 文栏，中间固定留出 7mm 栏间距。</p>
          </div>
        </figcaption>

        <div
          class="column-spec"
          role="img"
          aria-label="正文双栏网格：左右栏宽各 83 毫米，中间栏间距 7 毫米，总版心宽 173 毫米"
        >
          <div class="column-spec__page" aria-hidden="true">
            <div class="column-spec__grid">
              <span class="column-spec__column"><b>01</b><i></i><strong>83 MM</strong></span>
              <span class="column-spec__gap"><b>GAP</b><strong>7<br />MM</strong></span>
              <span class="column-spec__column"><b>02</b><i></i><strong>83 MM</strong></span>
            </div>
          </div>
          <div class="column-spec__equation" aria-hidden="true">
            <span>83 MM</span><i>+</i><strong>7 MM GAP</strong><i>+</i><span>83 MM</span><b>= 173 MM</b>
          </div>
        </div>
      </figure>
    </div>

    <dl class="container layout-standard__rules">
      <div><dt>PAPER</dt><dd>A4 <span>210 × 297 MM</span></dd></div>
      <div><dt>TOP / BOTTOM</dt><dd>14 / 15 MM <span>Vertical Margin</span></dd></div>
      <div><dt>INNER / OUTER</dt><dd>20 / 17 MM <span>Mirrored Margin</span></dd></div>
      <div><dt>COLUMNS</dt><dd>83 / 7 / 83 MM <span>Column · Gap · Column</span></dd></div>
    </dl>
  </section>

  <section class="article-title-standard" aria-labelledby="article-title-standard-title">
    <div class="container article-title-standard__heading">
      <div>
        <p class="eyebrow">Article Title / 文章标题区</p>
        <h2 id="article-title-standard-title">四层文字，<br />组成阅读入口。</h2>
      </div>
      <p>以带背景图和摘要的普通文章标题环境为例，标题区依次呈现分区、文章标题、摘要与撰文信息；字体、行距和透明度均对应 2026 书籍模板。</p>
    </div>

    <div class="container article-title-standard__content">
      <figure class="title-preview">
        <div class="title-preview__canvas">
          <img src={articleTitlePreview} alt="" loading="lazy" />
          <div class="title-preview__margin-guide" aria-hidden="true">
            <div class="title-preview__margin-measure">
              <span>左页边距</span>
              <i></i>
            </div>
          </div>
          <div class="title-preview__copy">
            <p class="title-preview__area">天文 / ASTRONOMY</p>
            <h3>天上的星星哪里来</h3>
            <p class="title-preview__abstract">追溯恒星的起源与演化，从分子云坍缩到原恒星形成，分析小质量、中等质量和大质量恒星的不同命运，诠释宇宙元素循环的壮丽史诗。</p>
            <p class="title-preview__credit">
              <b>撰文</b><i>/</i><span>作者姓名</span><small>福州一中天文社</small>
            </p>
          </div>
        </div>
        <figcaption>
          <span>背景 · 分区 · 标题 · 摘要 · 署名</span>
        </figcaption>
      </figure>

      <div class="title-type-table-wrap" role="region" aria-label="文章标题区四层文字参数" tabindex="0">
        <table class="title-type-table">
          <colgroup><col class="title-type-table__label" /><col /><col /><col /><col /></colgroup>
          <thead>
            <tr>
              <th scope="col">参数</th>
              <th scope="col"><span>01</span>分区<small>AREA</small></th>
              <th scope="col"><span>02</span>标题<small>TITLE</small></th>
              <th scope="col"><span>03</span>摘要<small>ABSTRACT</small></th>
              <th scope="col"><span>04</span>署名<small>BYLINE</small></th>
            </tr>
          </thead>
          <tbody>
            <tr><th scope="row">字体</th><td colspan="3">HarmonyOS Sans SC</td><td>Noto Serif CJK SC</td></tr>
            <tr><th scope="row">字重</th><td colspan="3">Medium</td><td>Black（撰文）<br />Medium（其余）</td></tr>
            <tr><th scope="row">字号</th><td>10 PT</td><td>28 PT</td><td>10 PT</td><td>8 PT</td></tr>
            <tr><th scope="row">行距</th><td>14 PT</td><td>34 PT</td><td>14 PT</td><td>12 PT</td></tr>
            <tr><th scope="row">透明度</th><td>80%</td><td>100%</td><td>100%</td><td>100%<small>社团 80%</small></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <dl class="container article-title-standard__rules">
      <div><dt>颜色</dt><dd>WHITE <span>四层文字统一使用纸白色</span></dd></div>
      <div><dt>对齐方式</dt><dd>左对齐 <span>四层文字统一左对齐</span></dd></div>
      <div><dt>层后间距</dt><dd>3.5 毫米 <span>分区、标题与摘要之后</span></dd></div>
      <div><dt>可选阴影</dt><dd>BLACK · 75% <span>横向 / 纵向偏移 · 0.05 em</span></dd></div>
    </dl>
  </section>

  <section class="body-text-standard" aria-labelledby="body-text-standard-title">
    <div class="container body-text-standard__heading">
      <div>
        <p class="eyebrow">Body Typography / 正文排版</p>
        <h2 id="body-text-standard-title">层层推进，<br />承接完整阅读。</h2>
      </div>
      <p>正文以轻字重和宽松行距维持长篇阅读的节奏，两级小标题使用学科主题色建立层级；图片编号与图注则以相同字号、不同字重组成一组居中的图例。</p>
    </div>

    <div class="container body-text-standard__content">
      <figure class="body-preview">
        <div class="body-preview__paper">
          <div class="body-preview__columns">
            <div class="body-preview__column">
              <h3>恒星如何开始发光</h3>
              <p>恒星诞生于寒冷而稠密的分子云。微小的密度扰动在引力作用下不断放大，使气体与尘埃逐渐向中心聚集，并释放出越来越多的能量。</p>
              <h4>从分子云到原恒星</h4>
              <p>坍缩核心持续升温，外围物质形成旋转的吸积盘。当核心温度足以点燃氢核聚变，向外的辐射压力与向内的引力达到平衡，一颗主序星由此诞生。</p>
              <p>恒星最初的质量决定了它此后的亮度、寿命与最终归宿，也塑造着星系中元素循环的方式。</p>
            </div>

            <div class="body-preview__column">
              <figure class="body-preview__figure">
                <img src={articleBodyPreview} alt="夜空中的星轨与山脉" loading="lazy" />
                <figcaption><b>图 1</b><span>恒星视运动形成的星轨；编号也可按上下文写作“上图”。</span></figcaption>
              </figure>
              <h4>质量决定恒星的命运</h4>
              <p>小质量恒星安静地演化为白矮星；更重的恒星则可能在超新星爆发后留下中子星或黑洞。它们抛出的重元素再次进入星际介质，成为新一代恒星与行星的原料。</p>
            </div>
          </div>
          <span class="body-preview__page-number" aria-hidden="true">24</span>
        </div>
        <figcaption class="body-preview__legend">一级小标题 · 二级小标题 · 正文 · 图片编号 · 图注</figcaption>
      </figure>

      <div class="body-type-table-wrap" role="region" aria-label="正文层级文字参数" tabindex="0">
        <table class="body-type-table">
          <thead>
            <tr>
              <th scope="col">样式</th>
              <th scope="col">字体与字重</th>
              <th scope="col">尺寸参数</th>
              <th scope="col">颜色与规则</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row"><span>01</span>一级小标题</th>
              <td>HarmonyOS Sans SC<small>Bold</small></td>
              <td><dl><div><dt>字号</dt><dd>12 PT</dd></div><div><dt>行距</dt><dd>16 PT</dd></div><div><dt>段后</dt><dd>2 MM</dd></div></dl></td>
              <td>学科主题色</td>
            </tr>
            <tr>
              <th scope="row"><span>02</span>二级小标题</th>
              <td>HarmonyOS Sans SC<small>Regular</small></td>
              <td><dl><div><dt>字号</dt><dd>10 PT</dd></div><div><dt>行距</dt><dd>14 PT</dd></div><div><dt>段后</dt><dd>2 MM</dd></div></dl></td>
              <td>学科主题色</td>
            </tr>
            <tr>
              <th scope="row"><span>03</span>正文内容</th>
              <td>HarmonyOS Sans SC<small>Light</small></td>
              <td><dl><div><dt>字号</dt><dd>9 PT</dd></div><div><dt>行距</dt><dd>16 PT</dd></div><div><dt>段后</dt><dd>2 MM</dd></div></dl></td>
              <td>BLACK</td>
            </tr>
            <tr>
              <th scope="row"><span>04</span>图片编号</th>
              <td>HarmonyOS Sans SC<small>Bold</small></td>
              <td><dl><div><dt>字号</dt><dd>7 PT</dd></div><div><dt>行距</dt><dd>9 PT</dd></div><div><dt>段后</dt><dd>—</dd></div></dl></td>
              <td>BLACK<small>图 1 / 上图</small></td>
            </tr>
            <tr>
              <th scope="row"><span>05</span>图注</th>
              <td>HarmonyOS Sans SC<small>Light</small></td>
              <td><dl><div><dt>字号</dt><dd>7 PT</dd></div><div><dt>行距</dt><dd>9 PT</dd></div><div><dt>段后</dt><dd>—</dd></div></dl></td>
              <td>BLACK<small>与编号间隔 0.5 EM</small></td>
            </tr>
          </tbody>
          <tfoot>
            <tr><td colspan="4"><b>图片与图例间距</b><span>4 PT</span><i>图例整体居中，并与图片绑定在同一栏内。</i></td></tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .color-overview {
    padding: clamp(75px, 10vw, 140px) 0;
  }

  .color-overview__grid {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.44fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: end;
  }

  .color-overview h2,
  .type-standard h2,
  .layout-standard h2,
  .article-title-standard h2,
  .body-text-standard h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 6vw, 6.4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.055em;
  }

  .color-overview__grid > p {
    margin: 0;
    color: var(--ink-soft);
  }

  .swatch-section {
    padding-bottom: clamp(80px, 12vw, 160px);
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .swatch {
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .swatch__color {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    color: white;
    background: var(--swatch);
  }

  .swatch--light .swatch__color {
    color: var(--ink);
  }

  .swatch__color span {
    font-size: 0.72rem;
    font-weight: 500;
  }

  .swatch__mark {
    align-self: end;
  }

  .swatch__copy {
    min-height: 280px;
    padding: 26px;
    background: var(--surface);
  }

  .swatch__copy > p:first-child {
    margin: 0 0 4px;
    color: var(--ink-soft);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .swatch__copy h2 {
    margin: 0 0 30px;
    font-size: 2rem;
    font-weight: 500;
  }

  .swatch dl {
    margin: 0;
  }

  .swatch dl div {
    display: grid;
    grid-template-columns: 70px 1fr;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    font-size: 0.72rem;
  }

  .swatch dt {
    color: var(--ink-soft);
    font-weight: 400;
  }

  .swatch dd {
    margin: 0;
    font-weight: 500;
  }

  .swatch__usage {
    margin: 24px 0 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .type-standard {
    padding: clamp(90px, 13vw, 180px) 0;
    color: white;
    background: #11151b;
  }

  .type-standard__grid {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: clamp(60px, 10vw, 140px);
  }

  .type-samples {
    border-top: 1px solid rgba(255, 255, 255, 0.4);
  }

  .type-sample {
    padding: 34px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .type-sample span {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .type-sample h3 {
    margin: 13px 0;
    font-size: clamp(1.7rem, 3.5vw, 3.6rem);
    line-height: 1.15;
  }

  .type-sample p {
    max-width: 590px;
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.86rem;
  }

  .type-sample--sans h3 {
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .type-sample--serif h3 {
    font-family: var(--font-editorial);
    font-weight: 900;
  }

  .type-sample--math h3 {
    font-family: var(--font-math);
    font-weight: 400;
  }

  .type-sample--math sup {
    font-size: 0.6em;
    line-height: 0;
  }

  .layout-standard {
    padding: clamp(90px, 13vw, 180px) 0;
    background: var(--paper);
  }

  .layout-standard__heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.44fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: end;
  }

  .layout-standard__heading > p {
    margin: 0;
    color: var(--ink-soft);
  }

  .layout-standard__demos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(58px, 8vw, 100px);
    border-top: 1px solid var(--line-strong);
  }

  .layout-demo {
    min-width: 0;
    margin: 0;
    padding: clamp(24px, 3vw, 38px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .layout-demo figcaption {
    display: grid;
    min-height: 150px;
    grid-template-columns: 78px minmax(0, 1fr);
    gap: 20px;
  }

  .layout-demo figcaption > span {
    color: var(--theme);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .layout-demo h3 {
    margin: 0;
    font-size: clamp(1.55rem, 2.8vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .layout-demo figcaption p {
    max-width: 24rem;
