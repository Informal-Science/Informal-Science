---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookMarker from '../components/BookMarker.astro';
import DisciplineGrid from '../components/DisciplineGrid.astro';
import IssueHeroBackground from '../components/IssueHeroBackground.astro';
import { siteMeta, articles, disciplines, issues } from '../data';
import { disciplineUiColor } from '../utils/colors';
import { withBase } from '../utils/paths';
const featuredArticles = siteMeta.coverFocusArticleSlugs
  .map((slug) => articles.find((article) => article.year === 2026 && article.catalogSlug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article))
  .slice(0, 3);

const currentIssue = issues.find((issue) => issue.year === 2026)!;
---

<BaseLayout image="/images/hero/hero-2026-1920.webp">
  <div class="home-intro">
    <div class="home-intro__backdrop">
      <IssueHeroBackground eager />
      <div class="home-intro__veil" aria-hidden="true"></div>
    </div>

    <div class="home-intro__foreground">
      <section class="home-hero" aria-labelledby="hero-title">
        <div class="container home-hero__content">
          <div class="home-hero__masthead">
            <p class="home-hero__tagline" aria-label={`${siteMeta.tagline.zh} · ${siteMeta.tagline.en}`}>
              <span aria-hidden="true">解</span>
              <span class="home-hero__soft" aria-hidden="true">所未曾释</span>
              <span class="home-hero__soft" aria-hidden="true">·</span>
              <span aria-hidden="true">Solve</span>
              <span class="home-hero__soft" aria-hidden="true">the Unsolved</span>
            </p>
            <h1 id="hero-title" class="display-title">非正式科学</h1>
            <p class="home-hero__english" aria-label="INFORMAL SCIENCE">
              <span class="home-hero__english-initial" aria-hidden="true">I</span><span aria-hidden="true">NFORMAL</span>
              <span class="home-hero__english-gap" aria-hidden="true"> </span>
              <span class="home-hero__english-initial" aria-hidden="true">S</span><span aria-hidden="true">CIENCE</span>
            </p>
            <div class="home-hero__publication" aria-label="基础科学社团联盟独家刊物，七大社团联袂献上，2026 年刊总第 6 期">
              <p>基础科学社团联盟 独家刊物</p>
              <p>七大社团 联袂献上</p>
              <p>2026年刊<span class="home-hero__quad">总第6期</span></p>
            </div>
          </div>

          <div class="home-hero__bottom">
            <div>
              <strong>在未解之处，继续发问。</strong>
            </div>
            <nav class="home-hero__actions" aria-label="本期入口">
              <a class="button-link button-link--hero" href={withBase('/2026')}>进入本期</a>
              <a class="button-link button-link--hero" href={withBase('/subscribe')}>立即订阅</a>
            </nav>
          </div>
        </div>
      </section>

      <section class="home-statement">
        <div class="container statement-grid">
          <p class="eyebrow">2026 / ISSUE NO. 06</p>
          <div>
            <h2>一本由学生写作、编辑与设计的科学年刊。</h2>
            <p>从宇宙尺度到分子结构，从城市肌理到飞行机械。七个学科方向，二十四篇目录导读，记录青年对世界的好奇。</p>
            <a class="text-link" href={withBase('/2026')}>查看 2026 年刊</a>
          </div>
        </div>
      </section>
    </div>
  </div>

  <section class="home-section home-section--disciplines">
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Seven Fields</p>
        <h2 class="section-title">七大板块</h2>
      </div>
      <div class="section-heading__action">
        <p>每个板块都拥有来自书籍视觉规范的独立学科色。</p>
        <a class="text-link" href={withBase('/disciplines')}>认识全部板块</a>
      </div>
    </div>
    <DisciplineGrid compact />
  </section>

  <section class="home-section home-featured">
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Selected Stories</p>
        <h2 class="section-title">本期选读</h2>
      </div>
      <div class="section-heading__action">
        <p>从完整目录中选择三个入口。网站首版提供经书籍工程整理的目录导读。</p>
        <a class="text-link" href={withBase('/history/2026#directory')}>浏览本期文章</a>
      </div>
    </div>

    <div class="container featured-grid">
      {featuredArticles.map((article, index) => {
        const discipline = disciplines.find((item) => item.slug === article.disciplineSlug)!;
        return (
          <a
            class="featured-card"
            href={withBase(`/history/2026#${article.slug}`)}
            style={`--card-color: ${disciplineUiColor(discipline.colorKey)}`}
          >
            <BookMarker
              kind="toc-number"
              value={String(index + 1)}
              size="2.25rem"
              foreground="white"
              background="var(--card-color)"
            />
            <p class="featured-card__labels">
              <span>{discipline.name} / {discipline.en}</span>
              <span>{article.year}年刊 · 总第{article.issueNumber}期</span>
            </p>
            <h3>{article.title}</h3>
            <div>
              <span>撰文 {article.author}</span>
              <span>第 {article.page} 页</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="home-section home-history">
    <div class="container history-grid">
      <div class="history-copy">
        <p class="eyebrow">Past Issues / 2021—2026</p>
        <h2 class="section-title editorial-title">一期接一期，精彩不停。</h2>
        <p>《非正式科学》已经走过了五个年头，每一期《非正式科学》都承载着少年心中的好奇、思考、与表达。</p>
        <a class="button-link" href={withBase('/history')}>进入往期精彩</a>
      </div>
      <a class="history-cover" href={withBase('/history/2026')}>
        <img
          src={withBase(currentIssue.coverAsset)}
          alt="《非正式科学》2026 年刊封面"
          width="1200"
          height="1698"
          loading="lazy"
        />
        <span>2026 · 总第 6 期 <b aria-hidden="true">↗</b></span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro {
    position: relative;
    display: grid;
    isolation: isolate;
    color: white;
    background: #111722;
  }

  .home-intro__backdrop,
  .home-intro__foreground {
    min-width: 0;
    grid-area: 1 / 1;
  }

  .home-intro__backdrop {
    position: sticky;
    z-index: 0;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    align-self: start;
    overflow: hidden;
    pointer-events: none;
  }

  .home-intro__foreground {
    position: relative;
    z-index: 1;
  }

  .home-intro__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 5, 10, 0.72) 0%, rgba(2, 5, 10, 0.34) 48%, rgba(2, 5, 10, 0.48) 100%),
      linear-gradient(0deg, rgba(2, 5, 10, 0.72) 0%, rgba(2, 5, 10, 0.08) 48%, rgba(2, 5, 10, 0.2) 100%);
  }

  .home-hero {
    position: relative;
    z-index: 1;
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: calc(100svh - var(--nav-height));
    grid-template-rows: 1fr auto;
    padding: clamp(48px, 7vh, 72px) 0 clamp(44px, 7vh, 78px);
  }

  .home-hero__masthead {
    align-self: start;
    max-width: 930px;
  }

  .home-hero__tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.247em;
    margin: 0 0 clamp(10px, 1.3vw, 17px);
    font-family: var(--font-editorial);
    font-size: clamp(0.78rem, 1.24vw, 1.08rem);
    font-weight: 900;
    line-height: 1.2857;
    letter-spacing: 0.142em;
  }

  .home-hero__soft {
    opacity: 0.8;
  }

  .home-hero .display-title {
    width: max-content;
    max-width: 100%;
    font-size: clamp(4.25rem, 10.2vw, 8.8rem);
    line-height: 1.11;
    letter-spacing: 0.11em;
    transform: translateX(-0.8333%);
  }

  .home-hero__english {
    display: flex;
    width: max-content;
    max-width: 100%;
    align-items: baseline;
    margin: clamp(2px, 0.5vw, 7px) 0 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.05rem, 2.18vw, 1.8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.1em;
  }

  .home-hero__english > span:not(.home-hero__english-initial) {
    opacity: 0.9;
  }

  .home-hero__english-initial {
    font-size: 1.3em;
    opacity: 1;
  }

  .home-hero__english-gap {
    width: 0.45em;
  }

  .home-hero__publication {
    display: grid;
    gap: 1px;
    margin-top: clamp(14px, 1.7vw, 22px);
    font-family: var(--font-editorial);
    font-size: clamp(0.75rem, 1.1vw, 1rem);
    font-weight: 900;
    line-height: 1.35;
    letter-spacing: 0.14em;
  }

  .home-hero__publication p {
    margin: 0;
  }

  .home-hero__publication p:nth-child(2),
  .home-hero__publication p:nth-child(3) {
    font-size: 0.9167em;
    opacity: 0.9;
  }

  .home-hero__publication p:nth-child(3) {
    font-weight: 600;
  }

  .home-hero__quad {
    display: inline-block;
    margin-inline-start: 1em;
  }

  .home-hero__bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
  }

  .home-hero__bottom strong {
    font-size: clamp(1.1rem, 2.1vw, 1.8rem);
    font-weight: 400;
  }

  .home-hero__actions {
    display: grid;
    width: max-content;
    gap: 12px;
  }

  .home-hero__actions .button-link:hover {
    color: var(--ink);
    background: white;
  }

  .home-hero__actions .button-link--hero {
    min-width: 210px;
    min-height: 62px;
    padding-inline: 34px;
    font-size: 1.15rem;
  }

  .home-statement {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 100svh;
    align-items: center;
    padding: clamp(90px, 14vw, 190px) 0;
  }

  .statement-grid {
    display: grid;
    grid-template-columns: 0.36fr 1fr;
    gap: clamp(32px, 8vw, 120px);
  }

  .statement-grid h2 {
    max-width: 940px;
    margin: 0;
    font-size: clamp(2.1rem, 5.5vw, 5.7rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.055em;
  }

  .statement-grid > div > p {
    max-width: 620px;
    margin: 30px 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .home-statement .eyebrow {
    color: rgba(255, 255, 255, 0.68);
  }

  .home-section {
    padding: clamp(76px, 11vw, 150px) 0;
    border-top: 1px solid var(--line);
  }

  .home-section--disciplines {
    position: relative;
    z-index: 1;
    padding-bottom: 0;
    background: var(--paper);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.45fr);
    gap: 40px;
    align-items: end;
    margin-bottom: clamp(46px, 7vw, 84px);
  }

  .section-heading__action {
    justify-self: end;
    max-width: 360px;
  }

  .section-heading__action p {
    margin: 0 0 18px;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .featured-card {
    position: relative;
    display: flex;
    min-height: 420px;
    flex-direction: column;
    padding: clamp(24px, 3.2vw, 42px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: color 220ms ease, background 220ms ease;
  }

  .featured-card:hover,
  .featured-card:focus-visible {
    color: var(--ink);
    background: var(--card-color);
  }

  .featured-card > p {
    margin: 32px 0 11px;
    color: var(--card-color);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: color 220ms ease;
  }

  .featured-card:hover > p,
  .featured-card:focus-visible > p {
    color: var(--ink);
  }

  .featured-card__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .featured-card__labels span {
    padding: 3px 6px;
    border: 1px solid currentColor;
    line-height: 1;
  }

  .featured-card h3 {
    margin: 0;
    font-size: clamp(1.55rem, 2.6vw, 2.7rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.045em;
  }

  .featured-card > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 28px;
    border-top: 1px solid currentColor;
    font-size: 0.72rem;
  }

  .home-history {
    color: white;
    background: #11151b;
  }

  .history-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: clamp(60px, 12vw, 170px);
    align-items: center;
  }

  .history-copy p:not(.eyebrow) {
    max-width: 550px;
    margin: 30px 0;
    color: rgba(255, 255, 255, 0.62);
  }

  .history-copy .button-link:hover {
    color: var(--ink);
    background: white;
  }

  .history-cover {
    display: grid;
    width: min(100%, 300px);
    gap: 15px;
    justify-self: end;
  }

  .history-cover img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.22);
    object-fit: contain;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
    transition: transform 300ms ease;
  }

  .history-cover:hover img,
  .history-cover:focus-visible img {
    transform: translateY(-7px) rotate(0.4deg);
  }

  .history-cover span {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
  }

  @media (max-width: 800px) {
    .statement-grid,
    .section-heading,
    .history-grid {
      grid-template-columns: 1fr;
    }

    .section-heading__action {
      justify-self: start;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      min-height: 300px;
    }

    .history-cover {
      width: min(68vw, 280px);
      justify-self: center;
    }
  }

  @media (max-width: 520px) {
    .home-hero__content {
      padding-top: 52px;
    }

    .home-hero__tagline {
      font-size: 0.68rem;
    }

    .home-hero .display-title {
      font-size: clamp(3.45rem, 17.5vw, 4.25rem);
    }

    .home-hero__english {
      font-size: 0.88rem;
    }

    .home-hero__publication {
      margin-top: 13px;
      font-size: 0.62rem;
    }

    .home-hero__bottom {
      display: grid;
    }

    .home-hero__actions {
      width: fit-content;
    }
  }

  /* 横屏手机：让主题照片、刊名和入口在有限高度内保持清晰层级。 */
  @media (orientation: landscape) and (max-height: 560px) {
    .home-hero,
    .home-hero__content {
      min-height: max(280px, calc(100svh - var(--nav-height)));
    }

    .home-statement {
      min-height: max(330px, calc(100svh - 62px));
    }

    .home-hero__content {
      padding: 28px 0 24px;
    }

    .home-hero__tagline {
      margin-bottom: 10px;
      font-size: 0.68rem;
    }

    .home-hero .display-title {
      font-size: clamp(3.25rem, 18vh, 5.2rem);
    }

    .home-hero__english {
      margin-top: 2px;
      font-size: 0.74rem;
    }

    .home-hero__publication {
      gap: 0;
      margin-top: 8px;
      font-size: 0.58rem;
      line-height: 1.2;
    }

    .home-hero__bottom {
      display: grid;
      align-items: end;
      gap: 8px;
    }

    .home-hero__bottom strong {
      font-size: 1rem;
    }

    .home-hero__actions {
      grid-template-columns: repeat(2, 170px);
      justify-self: end;
    }

    .home-hero__actions .button-link--hero {
      min-width: 170px;
      min-height: 50px;
      padding-inline: 24px;
      font-size: 1rem;
    }

  }
</style>
