---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ArticleDirectory from '../../components/ArticleDirectory.astro';
import { articles, disciplines, siteMeta } from '../../data';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="2026 年刊"
  description="《非正式科学》2026 年刊总目录：七大学科，二十四篇科学文章导读。"
>
  <PageIntro
    eyebrow="2026 Annual · Issue No. 06"
    title="2026 年刊"
    description="总第 6 期。由七个学科方向共同构成的年度科学读本，记录问题如何被提出、拆解与继续追问。"
    aside="本页内容来自书籍工程的 2026 年刊目录。现阶段公开题名、作者与摘要，全文将在正式排版完成后逐步开放。"
  />

  <section class="issue-summary">
    <div class="container issue-summary__grid">
      <div class="issue-number">
        <span>06</span>
        <p>总第六期<br />2026 年刊</p>
      </div>
      <div class="issue-copy">
        <p class="eyebrow">Editorial Direction</p>
        <h2>解所未曾释，<br />Solve the Unsolved.</h2>
        <p>{siteMeta.description}</p>
        <a class="text-link" href={withBase('/disciplines')}>先从七大板块开始</a>
      </div>
      <dl class="issue-stats">
        <div><dt>7</dt><dd>学科板块</dd></div>
        <div><dt>24</dt><dd>目录导读</dd></div>
        <div><dt>6</dt><dd>年度传承</dd></div>
      </dl>
    </div>
  </section>

  <section class="directory-section" id="directory">
    <div class="container directory-heading">
      <p class="eyebrow">Contents / 目录</p>
      <h2 class="section-title">二十四个问题入口</h2>
      <p>可按学科筛选，或搜索题名、作者与摘要。</p>
    </div>
    <div class="container">
      <ArticleDirectory entries={articles} disciplines={disciplines} searchable showFilter />
    </div>
  </section>
</BaseLayout>

<style>
  .issue-summary {
    padding: clamp(70px, 10vw, 140px) 0;
  }

  .issue-summary__grid {
    display: grid;
    grid-template-columns: 0.42fr 1fr 0.42fr;
    gap: clamp(34px, 7vw, 100px);
    align-items: start;
  }

  .issue-number span {
    display: block;
    color: var(--theme);
    font-size: clamp(6rem, 13vw, 12rem);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.1em;
  }

  .issue-number p {
    margin: 25px 0 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
  }

  .issue-copy h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.4rem, 5vw, 5.2rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.055em;
  }

  .issue-copy > p:not(.eyebrow) {
    max-width: 610px;
    margin: 28px 0;
    color: var(--ink-soft);
  }

  .issue-stats {
    display: grid;
    gap: 24px;
    margin: 0;
  }

  .issue-stats div {
    padding-top: 12px;
    border-top: 1px solid var(--line-strong);
  }

  .issue-stats dt {
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1;
  }

  .issue-stats dd {
    margin: 6px 0 0;
    color: var(--ink-soft);
    font-size: 0.76rem;
  }

  .directory-section {
    padding: clamp(78px, 11vw, 150px) 0;
    background: var(--surface);
  }

  .directory-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: end;
    margin-bottom: 50px;
  }

  .directory-heading .eyebrow {
    grid-column: 1 / -1;
  }

  .directory-heading > p:last-child {
    max-width: 330px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 820px) {
    .issue-summary__grid {
      grid-template-columns: 1fr;
    }

    .issue-number {
      display: flex;
      align-items: end;
      gap: 28px;
    }

    .issue-number p {
      margin-bottom: 0;
    }

    .issue-stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .directory-heading {
      grid-template-columns: 1fr;
    }
  }
</style>
