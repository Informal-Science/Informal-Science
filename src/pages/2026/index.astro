---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueHeroBackground from '../../components/IssueHeroBackground.astro';
import { articles, disciplines, issues, siteMeta } from '../../data';
import { disciplineUiColor } from '../../utils/colors';
import { withBase } from '../../utils/paths';

const currentIssue = issues.find((issue) => issue.year === 2026)!;
const focusArticles = siteMeta.coverFocusArticleSlugs
  .map((slug) => articles.find((article) => article.year === 2026 && article.catalogSlug === slug))
  .filter((article): article is (typeof articles)[number] => Boolean(article));
const disciplineMap = new Map<string, (typeof disciplines)[number]>(
  disciplines.map((discipline) => [discipline.slug, discipline]),
);
---

<BaseLayout
  title="2026 年刊"
  description="《非正式科学》2026 年刊：封面焦点、封面故事与本期文章入口。"
  image="/images/hero/hero-2026-1920.webp"
>
  <div class="annual-intro">
    <div class="annual-intro__backdrop">
      <IssueHeroBackground eager />
      <div class="annual-intro__veil" aria-hidden="true"></div>
    </div>

    <div class="annual-intro__foreground">
      <section class="annual-hero" aria-labelledby="annual-title">
        <div class="container annual-hero__content">
          <div class="annual-hero__copy">
            <p class="annual-hero__eyebrow">Annual Edition / Issue No. 06</p>
            <h1 id="annual-title">
              <span class="annual-hero__title">非正式科学</span>
              <span class="annual-hero__edition">2026年刊&nbsp;总第6期</span>
            </h1>
            <p class="annual-hero__tagline" aria-label={`${siteMeta.tagline.zh} · ${siteMeta.tagline.en}`}>
              <span class="annual-hero__tagline-group" aria-hidden="true">
                <span>解</span><span class="annual-hero__tagline-soft">所未曾释</span>
              </span>
              <span class="annual-hero__tagline-soft" aria-hidden="true">·</span>
              <span class="annual-hero__tagline-group" lang="en" aria-hidden="true">
                <span>Solve</span><span class="annual-hero__tagline-soft">the Unsolved</span>
              </span>
            </p>
          </div>

          <p class="annual-hero__issue" aria-label="总第六期">06</p>

          <div class="annual-hero__actions">
            <a class="button-link button-link--hero annual-hero__subscribe" href={withBase('/subscribe')}>立即订阅</a>
          </div>

          <div class="annual-hero__bottom">
            <dl>
              <div><dt>7</dt><dd>学科板块</dd></div>
              <div><dt>24</dt><dd>目录导读</dd></div>
              <div><dt>06</dt><dd>总期数</dd></div>
            </dl>
            <nav aria-label="2026 年刊快捷入口">
              <a href={withBase('/history/2026#directory')}>查看本期文章</a>
              <a href={withBase('/history')}>查看往期精彩</a>
              <a href={withBase('/questions-answers')}>检索历年文章</a>
            </nav>
          </div>
        </div>
      </section>

      <section class="cover-story" id="cover-story" aria-labelledby="cover-story-title">
        <div class="container cover-story__grid">
          <div class="cover-story__label">
            <p class="eyebrow">封面故事 / Cover Story</p>
            <span>{currentIssue.year} · Issue {String(currentIssue.number).padStart(2, '0')}</span>
          </div>

          <div class="cover-story__body">
            <h2 id="cover-story-title">{siteMeta.coverStory.title}</h2>
            <blockquote>“{siteMeta.coverStory.quote}”</blockquote>
            <cite>——{siteMeta.coverStory.attribution}</cite>
          </div>

          <p class="cover-story__mark" aria-hidden="true">STORY</p>
        </div>
      </section>
    </div>
  </div>

  <section class="cover-focus" id="cover-focus" aria-labelledby="cover-focus-title">
    <div class="container cover-focus__grid">
      <header class="cover-focus__intro">
        <p class="eyebrow">封面聚焦 / Cover Focus</p>
        <h2 id="cover-focus-title">七个问题，<br />从封面出发。</h2>
        <p>本期封面选出的七篇文章，沿着七个学科方向展开。点击题目可直达 2026 年刊目录中的对应条目。</p>
      </header>

      <ol class="cover-focus__list">
        {focusArticles.map((article, index) => {
          const discipline = disciplineMap.get(article.disciplineSlug)!;
          return (
            <li style={`--focus-color: ${disciplineUiColor(discipline.colorKey)}`}>
              <a href={withBase(`/history/2026#${article.slug}`)}>
                <span class="cover-focus__number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <p>{discipline.name} / {discipline.en}</p>
                  <h3>{article.title}</h3>
                </div>
                <b aria-hidden="true">↗</b>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

</BaseLayout>

<style>
  .annual-intro {
    position: relative;
    display: grid;
    isolation: isolate;
    color: white;
    background: #101722;
  }

  .annual-intro__backdrop,
  .annual-intro__foreground {
    min-width: 0;
    grid-area: 1 / 1;
  }

  .annual-intro__backdrop {
    position: sticky;
    z-index: 0;
    top: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    align-self: start;
    overflow: hidden;
    pointer-events: none;
  }

  .annual-intro__foreground {
    position: relative;
    z-index: 1;
  }

  .annual-hero {
    position: relative;
    min-height: calc(100svh - var(--nav-height));
    overflow: hidden;
  }

  .annual-intro__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 5, 10, 0.78) 0%, rgba(2, 5, 10, 0.24) 58%, rgba(2, 5, 10, 0.48) 100%),
      linear-gradient(0deg, rgba(2, 5, 10, 0.82) 0%, transparent 52%);
  }

  .annual-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    container-type: inline-size;
    min-height: calc(100svh - var(--nav-height));
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto auto;
    column-gap: 50px;
    row-gap: 0;
    padding-top: clamp(54px, 8vh, 90px);
    padding-bottom: clamp(42px, 7vh, 76px);
  }

  .annual-hero__copy {
    min-width: 0;
    align-self: center;
    transform: translateY(clamp(30px, 4vh, 40px));
  }

  .annual-hero__eyebrow {
    margin: 0 0 18px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .annual-hero h1 {
    display: grid;
    width: max-content;
    max-width: 100%;
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(3.3rem, 7vw, 7rem);
    font-weight: 900;
    line-height: 1.02;
  }

  .annual-hero__title {
    /* 书籍封面：刊名 x=18.25mm，其余信息 x=20mm；探出量为 1.75/210=0.8333% 纸宽。 */
    transform: translateX(-0.833333cqw);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .annual-hero__edition {
    margin-top: 0.28em;
    font-size: 0.54em;
    font-weight: 600;
    letter-spacing: 0.1em;
    opacity: 0.82;
    white-space: nowrap;
  }

  .annual-hero__tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.247em;
    margin: clamp(28px, 4vw, 48px) 0 0;
    font-family: var(--font-editorial);
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    font-weight: 900;
    line-height: 1.2857;
    letter-spacing: 0.142em;
  }

  .annual-hero__tagline-soft {
    opacity: 0.8;
  }

  .annual-hero__tagline-group {
    display: inline-flex;
    gap: 0 0.247em;
  }

  .annual-hero__tagline span {
    flex: none;
    white-space: nowrap;
  }

  .annual-hero__issue {
    align-self: start;
    margin: 0;
    font-size: clamp(5rem, 13vw, 12rem);
    font-weight: 300;
    line-height: 0.72;
    letter-spacing: -0.08em;
    opacity: 0.28;
  }

  .annual-hero__actions {
    display: grid;
    min-width: 0;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) 340px;
    margin-top: 16px;
    padding-bottom: clamp(28px, 4vh, 38px);
  }

  .annual-hero__bottom {
    display: grid;
    min-width: 0;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 40px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.48);
  }

  .annual-hero__bottom dl {
    display: flex;
    gap: clamp(28px, 5vw, 70px);
    margin: 0;
  }

  .annual-hero__bottom dl div {
    display: grid;
  }

  .annual-hero__bottom dt {
    font-size: 1.65rem;
    font-weight: 300;
    line-height: 1;
  }

  .annual-hero__bottom dd {
    margin: 6px 0 0;
    font-size: 0.68rem;
    opacity: 0.65;
  }

  .annual-hero__bottom nav {
    display: flex;
    width: max-content;
    max-width: 100%;
    flex-wrap: wrap;
    gap: 12px 26px;
    justify-content: end;
  }

  .annual-hero__bottom nav a {
    padding-bottom: 4px;
    border-bottom: 1px solid currentColor;
    font-weight: 500;
  }

  .annual-hero__subscribe {
    grid-column: 2;
    justify-self: center;
  }

  .annual-hero__subscribe:hover {
    color: var(--ink);
    background: white;
  }

  .cover-focus {
    padding: clamp(88px, 13vw, 180px) 0;
    color: rgba(255, 255, 255, 0.9);
    background: #11151b;
  }

  .cover-focus__grid {
    display: grid;
    grid-template-columns: minmax(560px, 0.9fr) minmax(0, 1fr);
    gap: clamp(50px, 6vw, 90px);
    align-items: start;
  }

  .cover-focus__intro {
    position: sticky;
    top: calc(var(--nav-height) + 36px);
  }

  .cover-focus .eyebrow {
    color: rgba(255, 255, 255, 0.48);
  }

  .cover-focus__intro h2 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.75rem, 6.2vw, 5.4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .cover-focus__intro > p:last-child {
    max-width: 430px;
    margin: 30px 0 0;
    color: rgba(255, 255, 255, 0.52);
  }

  .cover-focus__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.38);
    list-style: none;
  }

  .cover-focus__list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .cover-focus__list a {
    position: relative;
    display: grid;
    min-height: 136px;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
  }

  .cover-focus__list a::before {
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -22px;
    width: 4px;
    background: var(--focus-color);
    content: '';
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .cover-focus__list a:hover::before,
  .cover-focus__list a:focus-visible::before {
    opacity: 1;
  }

  .cover-focus__number,
  .cover-focus__list p {
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .cover-focus__list p {
    margin: 0 0 6px;
    color: var(--focus-color);
  }

  .cover-focus__list h3 {
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 2.15rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .cover-focus__list b {
    font-size: 1.1rem;
    font-weight: 400;
  }

  .cover-story {
    position: relative;
    display: grid;
    min-height: 100svh;
    align-items: center;
    padding: clamp(100px, 15vw, 210px) 0;
    overflow: hidden;
  }

  .cover-story__grid {
    position: relative;
    display: grid;
    grid-template-columns: 0.35fr minmax(0, 1fr);
    gap: clamp(40px, 9vw, 130px);
    align-items: start;
  }

  .cover-story__label span {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .cover-story .eyebrow {
    color: rgba(255, 255, 255, 0.68);
  }

  .cover-story__body {
    position: relative;
    z-index: 1;
    max-width: 920px;
  }

  .cover-story h2 {
    max-width: 860px;
    margin: 0;
    font-size: clamp(3rem, 7.2vw, 7.8rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.07em;
  }

  .cover-story blockquote {
    max-width: 760px;
    margin: clamp(54px, 8vw, 100px) 0 18px;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.48);
    font-family: var(--font-editorial);
    font-size: clamp(1.35rem, 2.6vw, 2.6rem);
    font-weight: 600;
    line-height: 1.65;
  }

  .cover-story cite {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.8rem;
    font-style: normal;
  }

  .cover-story__mark {
    position: absolute;
    right: -0.05em;
    bottom: -0.3em;
    margin: 0;
    color: rgba(255, 255, 255, 0.045);
    font-size: clamp(8rem, 24vw, 25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.08em;
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .annual-hero__content,
    .cover-focus__grid,
    .cover-story__grid {
      grid-template-columns: 1fr;
    }

    .annual-hero__issue {
      position: absolute;
      top: 52px;
      right: 0;
    }

    .annual-hero__bottom {
      grid-template-columns: 1fr;
    }

    .annual-hero__actions {
      grid-template-columns: minmax(0, 340px);
      justify-content: start;
    }

    .annual-hero__subscribe {
      grid-column: 1;
    }

    .annual-hero__bottom nav {
      justify-content: start;
    }

    .cover-focus__intro {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .annual-hero h1 {
      font-size: clamp(2.3rem, 12vw, 4.3rem);
    }

    .annual-hero__tagline {
      flex-wrap: wrap;
      gap: 0 0.247em;
      font-size: clamp(0.95rem, 4.5vw, 1.1rem);
    }

    .annual-hero__issue {
      font-size: 5rem;
    }

    .annual-hero__bottom dl {
      width: 100%;
      justify-content: space-between;
      gap: 18px;
    }

    .annual-hero__actions {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 40px;
    }

    .annual-hero__bottom nav {
      width: 100%;
      justify-self: center;
      justify-content: center;
    }

    .cover-focus__list a {
      grid-template-columns: 36px minmax(0, 1fr) auto;
      gap: 12px;
    }
  }

  @media (max-width: 380px) {
    .annual-hero__issue {
      font-size: clamp(4rem, 20vw, 5rem);
    }
  }

  @media (orientation: landscape) and (max-height: 560px) {
    .annual-hero,
    .annual-hero__content {
      min-height: max(360px, calc(100svh - var(--nav-height)));
    }

    .annual-hero__content {
      padding-top: 28px;
      padding-bottom: 24px;
    }

    .annual-hero__copy {
      transform: none;
    }

    .annual-hero h1 {
      font-size: clamp(2.9rem, 13vh, 5.2rem);
    }

    .annual-hero__tagline {
      margin-top: 18px;
      font-size: 0.9rem;
    }

    .annual-hero__issue {
      font-size: 5rem;
    }

    .annual-hero__actions {
      margin-top: 16px;
      padding-bottom: 20px;
    }
  }
</style>
