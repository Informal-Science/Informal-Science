---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ArticleDirectory from '../../components/ArticleDirectory.astro';
import { articles, contentDisciplines, issues } from '../../data';
---

<BaseLayout
  title="文章检索"
  description="跨年份搜索《非正式科学》2021 至 2026 年刊的文章题名、作者与摘要。"
>
  <PageIntro
    eyebrow="Article Search / 2021—2026"
    title="文章检索"
    description="从历年的问题出发，在题名、作者与摘要中寻找线索。可同时按学科与年份（期次）缩小范围。"
    aside={`当前收录 ${issues.length} 期、${articles.length} 条年度文章导读。2021 至 2026 年目录已整理；2026 年目录依据 Beta-B-2 版本录入，页码暂填 1，待最终确定后更新。`}
    editorial
  />

  <section class="search-archive" id="search">
    <div class="container search-archive__heading">
      <div>
        <p class="eyebrow">Article Finder</p>
        <h2 class="section-title">六期文章，一处检索。</h2>
      </div>
      <p>搜索会同时匹配题名、作者、摘要、年份与期数；学科与年份（期次）条件可叠加使用。</p>
    </div>
    <div class="container">
      <ArticleDirectory
        entries={articles}
        disciplines={contentDisciplines}
        searchable
        showFilter
        showIssueFilter
      />
    </div>
  </section>
</BaseLayout>

<style>
  .search-archive {
    padding: clamp(76px, 11vw, 150px) 0;
    background: var(--surface);
  }

  .search-archive__heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.38fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 54px;
  }

  .search-archive__heading > p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .search-archive__heading {
      grid-template-columns: 1fr;
    }
  }
</style>
