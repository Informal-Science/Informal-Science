---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="页面未找到" description="这个页面暂时不存在。" noIndex>
  <section class="not-found">
    <div class="container not-found__inner">
      <span>404</span>
      <p class="eyebrow">Unsolved Route</p>
      <h1>这个问题，<br />暂时没有页面。</h1>
      <p>链接可能已更新，或者内容仍在整理中。</p>
      <a class="button-link" href={withBase('/')}>返回首页</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 72vh;
    place-items: center;
    padding: 80px 0;
  }

  .not-found__inner {
    position: relative;
  }

  .not-found__inner > span {
    position: absolute;
    z-index: -1;
    top: -80px;
    right: 0;
    color: rgba(17, 18, 20, 0.05);
    font-size: clamp(10rem, 30vw, 30rem);
    font-weight: 700;
    line-height: 0.8;
  }

  .not-found h1 {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: clamp(3rem, 8vw, 8rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.065em;
  }

  .not-found__inner > p:not(.eyebrow) {
    margin: 30px 0;
    color: var(--ink-soft);
  }
</style>
